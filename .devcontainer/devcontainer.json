{
	// Environnement Codespaces des tests Kablix
	"name": "TestKablix",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"features": {
		// Node : scripts _generate / _verify (.mjs)
		"ghcr.io/devcontainers/features/node:1": { "version": "lts" },
		// Python : scripts MicroPython et analyse Pylance
		"ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
	},
	// arduino-cli + cœur AVR : compilation des .ino par Kablix
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"electropol-fr.kablix",
				"electropol-fr.arduino-vscode-ide",
				"electropol-fr.coloredtheme",
				"ms-ceintl.vscode-language-pack-fr",
				"paulober.pico-w-go",
				"raspberry-pi.raspberry-pi-pico",
				"alexnesnes.teleplot"
			],
			"settings": {
				"workbench.colorTheme": "Arduino light"
			}
		},
		"codespaces": {
			"openFiles": ["README.md"]
		}
	}
}
